    <string name="onboarding_allow">Allow and import</string>
    <string name="onboarding_title_1">Stay close to the people who matter</string>
    <string name="onboarding_body_1">KinKeep notices how often you speak to family and friends, then gently reminds you when it is time to call. No guilt, just a friendly nudge.</string>
    <string name="onboarding_title_2">Private by design</string>
    <string name="onboarding_body_2">Everything stays on your phone. KinKeep has no internet access at all, so your contacts and call history can never leave your device. Your notes are encrypted.</string>
    <string name="onboarding_title_3">Let us set it up</string>
    <string name="onboarding_body_3">Allow access to your contacts, call history and notifications. KinKeep suggests who to keep close, and you choose who to track.</string>

    <string name="settings_stale">Reminders have not checked in for %1$d hours. Your phone may be stopping KinKeep. Follow the tips below.</string>
    <string name="oem_title">Tips for your %1$s phone</string>
    <string name="oem_button">Open autostart settings</string>
    <string name="oem_samsung">Open Settings, Battery, Background usage limits. Make sure KinKeep is not in Sleeping apps or Deep sleeping apps, and add it to Never sleeping apps.</string>
    <string name="oem_xiaomi">Turn on Autostart for KinKeep. Then open Settings, Apps, KinKeep, Battery saver and choose No restrictions. Also lock KinKeep in the recent apps list.</string>
    <string name="oem_oppo">Allow KinKeep to Auto-launch, and under Battery choose Allow background activity. Lock KinKeep in the recent apps list.</string>
    <string name="oem_vivo">Allow KinKeep under Autostart, and under Battery choose High background power consumption or Allow. Lock KinKeep in the recent apps list.</string>
    <string name="oem_huawei">In Settings, Apps, App launch, switch KinKeep to Manage manually and turn on Auto-launch, Secondary launch and Run in background.</string>
    <string name="oem_transsion">Open Phone Master or Settings, Autostart manager, and allow KinKeep. Under Battery, set KinKeep to No restrictions and lock it in the recent apps list.</string>
    <string name="oem_other">Allow KinKeep to run in the background and set its battery use to Unrestricted. Some phones call this Autostart or Protected apps.</string>
    <string name="settings_diag_title">Diagnostics</string>
    <string name="settings_diag_body">If something goes wrong, KinKeep keeps a short record of crashes on this phone. It holds no names, numbers or notes. You decide whether to share it.</string>
